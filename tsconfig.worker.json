{
  // The Worker code alone, with the Workers types only: tsconfig.json also loads Bun's types for
  // the tests, which would let a Bun or Node global slip into src/ unnoticed.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "data/**/*.ts"]
}
